# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=7123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Supabase Project Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# IMPORTANT: Use the 'service_role' key, NOT the public 'anon' key,
# so the bot has administrative access to read and write database tables.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Super Admin Telegram User IDs (comma-separated list of numeric Telegram IDs)
# You can find your Telegram ID by messaging @userinfobot or @raw_data_bot
ADMIN_TELEGRAM_IDS=123456789,987654321

# Secret Token for Cron Jobs (secures /api/cron/check-expirations endpoint)
CRON_SECRET=quvasoy_gym_cron_secret_key_change_me

# Vercel Deployment Webhook URL (used by scripts/set-webhook.js)
WEBHOOK_URL=https://your-deployment-name.vercel.app/api/webhook

# Webhook Secret Token for Telegram Webhook Verification (optional but recommended)
WEBHOOK_SECRET_TOKEN=quvasoy_webhook_token_random_secret
